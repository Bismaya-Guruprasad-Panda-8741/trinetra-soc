# ============================================================
# TRINETRA SOC - Git Ignore
# ============================================================

# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*$py.class

# -------------------------
# Virtual Environment
# -------------------------
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# -------------------------
# Python Packaging
# -------------------------
build/
dist/
*.egg-info/
.eggs/

# -------------------------
# Testing / Coverage
# -------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# -------------------------
# Environment / Secrets
# -------------------------
.env
.env.*
*.secret
*.key
*.pem

# -------------------------
# Logs
# -------------------------
*.log
logs/

# -------------------------
# Temporary Files
# -------------------------
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# -------------------------
# IDE / Editors
# -------------------------
.vscode/
.idea/
*.code-workspace

# -------------------------
# Jupyter Notebook
# -------------------------
.ipynb_checkpoints/

# -------------------------
# Operating System
# -------------------------
.DS_Store
Thumbs.db
desktop.ini

# -------------------------
# Flask
# -------------------------
instance/
.webassets-cache/

# -------------------------
# Node / Frontend
# -------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -------------------------
# Local Configuration
# -------------------------
config.local.*
settings.local.*